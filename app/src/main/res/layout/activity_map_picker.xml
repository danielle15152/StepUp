<?xml version="1.0" encoding="utf-8"?>
<!--
    מסך בחירת מיקום למטרה.

    מבנה (זהה ל-fragment_map עם תוספת toolbar וכפתור אישור):
    - Toolbar עליון עם כותרת וחץ חזרה
    - מפה מלאה (FragmentContainerView)
    - SearchView צף בתוך MaterialCardView (מתחת ל-toolbar)
    - כפתור "אישור מיקום" צף בתחתית עם רקע אינדיגו
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".MapPickerActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/edit_goal_pick_location"
            app:titleCentered="false"
            app:titleTextAppearance="@style/TextAppearance.AppCompat.Title"
            app:titleTextColor="?attr/colorOnSurface" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!--
        SearchView לחיפוש מיקום - כרטיסייה לבנה עם פינות גדולות וצל,
        צפה מעל המפה (זהה לעיצוב ב-fragment_map).
    -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="80dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="?attr/colorSurface">

        <SearchView
            android:id="@+id/searchView"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:queryHint="@string/map_search_hint"
            android:iconifiedByDefault="false"
            android:background="@android:color/transparent" />

    </com.google.android.material.card.MaterialCardView>

    <!--
        כפתור צף בתחתית - אישור מיקום
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/confirm_location_button"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="20dp"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="אישור מיקום"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        app:cornerRadius="28dp"
        app:backgroundTint="@color/brand_indigo"
        app:icon="@drawable/ic_pin_small"
        app:iconGravity="textStart"
        app:iconTint="@android:color/white"
        app:elevation="8dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
