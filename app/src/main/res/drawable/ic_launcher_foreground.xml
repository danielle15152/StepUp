<?xml version="1.0" encoding="utf-8"?>
<!--
    Foreground של האייקון - 3 בלוקים שעולים בגובה + חץ עולה.
    הכל בתוך אזור 66x66 dp במרכז (מ-21 עד 87), כדי שלא ייחתך
    על ידי המסכות של המכשירים השונים (עיגול/ריבוע/דמעה).

    3 הבלוקים מסמלים את עליית המדרגות (StepUp), והחץ עם הנקודה
    מסמל יעד שמושג.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- בלוק 1 (השמאלי - הקטן ביותר). שקיפות 45% של לבן -->
    <path
        android:fillColor="#73FFFFFF"
        android:pathData="M30,72 L48,72 A4,4 0 0 1 52,76 L52,84 A4,4 0 0 1 48,88 L30,88 A4,4 0 0 1 26,84 L26,76 A4,4 0 0 1 30,72 Z" />

    <!-- בלוק 2 (האמצעי). שקיפות 75% של לבן -->
    <path
        android:fillColor="#BFFFFFFF"
        android:pathData="M56,52 L74,52 A4,4 0 0 1 78,56 L78,84 A4,4 0 0 1 74,88 L56,88 A4,4 0 0 1 52,84 L52,56 A4,4 0 0 1 56,52 Z" />

    <!-- בלוק 3 (הימני - הגבוה ביותר). לבן מלא -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M82,28 L100,28 A4,4 0 0 1 104,32 L104,84 A4,4 0 0 1 100,88 L82,88 A4,4 0 0 1 78,84 L78,32 A4,4 0 0 1 82,28 Z" />

    <!-- החץ העולה מבלוק 1 דרך 2 ל-3 - בצבע צהוב (sun) -->
    <path
        android:strokeColor="#FCD34D"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M36,60 L62,42 L88,22" />

    <!-- נקודה בקצה החץ - הופכת אותו ליעד מושג -->
    <path
        android:fillColor="#FCD34D"
        android:pathData="M88,15 A6,6 0 0 1 88,27 A6,6 0 0 1 88,15 Z" />

</vector>
