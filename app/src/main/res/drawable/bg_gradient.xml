<?xml version="1.0" encoding="utf-8"?>
<!--
    גרדיאנט אלכסוני של פלטת המותג: mint → indigo → ink.
    משמש ב-nav_header וכרקע למסך ההגדרות.
    angle="135" = הגרדיאנט נע מצד שמאל-עליון לימין-תחתון.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#14E0B1"
        android:centerColor="#6366F1"
        android:endColor="#0F1729" />
</shape>
